# MAGIC SCRIPT client configuration
# Copy this file to .env and fill in values locally. Never commit .env.

# Supabase control plane (publishable key only; never use a service-role key here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Existing Firebase Realtime Database bridge. Keep this project/path unchanged.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=zaem-a8d30.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://zaem-a8d30-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=zaem-a8d30
VITE_FIREBASE_STORAGE_BUCKET=zaem-a8d30.appspot.com
# Game data source provider ('firebase' [default] or 'labx')
VITE_GAME_DATA_SOURCE=firebase

# labx.site API URL (when VITE_GAME_DATA_SOURCE=labx)
VITE_LABX_API_URL=https://labx.site
