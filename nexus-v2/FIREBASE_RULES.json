{
  "rules": {
    ".read": false,
    ".write": false,
    "m11": {
      ".read": true,
      ".write": false,
      "$cell": {
        ".validate": "$cell.matches(/^m([1-9]|[1-4][0-9]|50)$/) && (newData.val() == 'a' || newData.val() == 'm')"
      }
    },
    "main": {
      ".read": true,
      ".write": false
    },
    "xbetmoney": {
      ".read": true,
      ".write": false
    }
  }
}
