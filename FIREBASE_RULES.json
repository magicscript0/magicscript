{
  "rules": {
    ".read": false,
    ".write": false,
    "m11": {
      ".read": true,
      ".write": false,
      ".validate": "newData.hasChildren()",
      "$key": {
        ".validate": "$key.matches(/^m([1-9]|[1-4][0-9]|50)$/) && (newData.isNumber() || newData.isBoolean() || newData.isString())"
      }
    }
  }
}
